# ===== Database =====
POSTGRES_USER=datepicker
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=datepicker

# ===== Backend =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_me_with_a_long_random_secret_at_least_64_chars
# Comma-separated list of allowed origins for CORS (frontend URL)
CORS_ORIGINS=http://localhost,http://localhost:5173
# Public base URL (used for invitation links, ICS file UID etc.)
PUBLIC_BASE_URL=http://localhost

# Initial admin account, created on first start if no admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# Default invitation name shown after the very first admin login if none exist.
INITIAL_INVITATION_NAME=Любимая

# Session settings
SESSION_COOKIE_NAME=dp_session
SESSION_MAX_AGE_SECONDS=86400

# ===== Telegram notifications (optional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Generic webhook (optional, Discord/Slack/own) =====
NOTIFY_WEBHOOK_URL=

# ===== Reverse proxy / HTTPS (production) =====
DOMAIN=localhost
ACME_EMAIL=
